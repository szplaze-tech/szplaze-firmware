/** 收起提示框并回到子菜单。
 *
 *  ⚠ 两个等待**都必须带超时**，这是本条函数的硬要求：
 *  `isButtonPressed()` 最终走 PCF8574 的 I2C 读，而该库在 I2C 读失败时
 *  会按内部缓冲把引脚返回成 LOW —— `!digitalRead()` 就成了 **true**。
 *  也就是说**只要 I2C 总线被拖死，所有按键都会被读成"一直按住"**，
 *  原来那个无超时的 `while (isButtonPressed(...))` 会永久空转：
 *  现象就是"提示框在、屏幕点不动、也退不出去"。
 *  加了上限之后，无论输入侧发生什么，界面一定能在有限时间内回来。 */
static void otherDismissPlaceholder() {
    delay(25);
    const uint32_t kReleaseWaitMs = 3000;
    const uint32_t kDismissWaitMs = 8000;

    uint32_t t0 = millis();
    while ((isButtonPressed(BTN_SELECT) || isButtonPressed(BTN_LEFT)) &&
           (uint32_t)(millis() - t0) < kReleaseWaitMs) {
        delay(5);
    }
    t0 = millis();
    while ((!isButtonPressed(BTN_SELECT) && !isButtonPressed(BTN_LEFT)) &&
           (uint32_t)(millis() - t0) < kDismissWaitMs) {
        int x = 0, y = 0;
        if (!readTouchXYDismiss(x, y) && !readTouchXY(x, y)) {
            delay(12);
            continue;
        }
        if (isNotificationVisible()) {
            NotificationAction a = notificationHandleTouch(x, y);
            if (a != NotificationAction::None) {
                break;
            }
            hideNotification();
        }
        break;
    }
    if (in_sub_menu) {
        submenu_initialized = false;
        if (current_menu_index == 2 && other_layer == OTHER_LAYER_HOME) {
            other_menu_grid_initialized = false;
            last_other_menu_index = -1;
        }
        displaySubmenu();
    }
}

static void otherRfidReturnGuard() {
    delay(120);
    for (int i = 0; i < 120; i++) {
        if (!isButtonPressed(BTN_SELECT) && !isButtonPressed(BTN_LEFT) &&
            !isButtonPressed(BTN_RIGHT) && !isButtonPressed(BTN_UP) &&
            !isButtonPressed(BTN_DOWN) && !isTouchDownDismiss()) {
            break;
        }
        delay(5);
    }
    delay(120);
}

/** 纯 ACK 探测：只问"这个地址在不在"，不读写任何数据。
 *  比整包事务快几个数量级（健康总线上约 0.1ms），适合秒判器件/总线是否活着。
 *  返回 true = 从机应答（endTransmission() == 0）。 */
static bool i2cPing(uint8_t addr) {
    Wire.beginTransmission(addr);
    return Wire.endTransmission() == 0;
}

/** 把三个 ACK 结果排成一行（0x20 键盘 / 0x75 IP5306 / 0x24 PN532）。 */
static void rfidAckLine(char* out, size_t n, bool pcf, bool pmic, bool nfc) {
    snprintf(out, n, "I2C  0x20:%s 0x75:%s 0x24:%s",
             pcf ? "OK" : "--", pmic ? "OK" : "--", nfc ? "OK" : "--");
}

/** 进 RFID 前的屏幕自检条（三行，占顶部 46px）。会被后续界面覆盖，用完不用清。
 *  目的：把"哪一环断了"直接写在屏幕上，不必接串口猜。 */
static void otherRfidProbeBanner(const char* l1, const char* l2, const char* l3, uint16_t color) {
    tft.fillRect(0, 0, tft.width(), 46, UI_BG);
    uiSetTextSize(1);
    uiSetTextFont(1);
    uiSetTextColor(color, UI_BG);
    uiSetCursor(4, 4);
    uiPrint(l1);
    uiSetCursor(4, 18);
    uiPrint(l2);
    uiSetTextColor(UI_TEXT, UI_BG);   // 第 3 行固定主文本色，专门放 ACK 状态
    uiSetCursor(4, 32);
    uiPrint(l3);
}

#if !RFID_USE_I2C
/** 裸 SPI 读 PN532 的 StatusRead(0x02)，**完全绕过库**，引脚可指定。
 *  为什么要能指定引脚：这块板上 MISO/MOSI 是**交叉**接法（代码期望
 *  PN532 的 MISO→11、MOSI→13，与 SD/CC1101 的同名网络正好相反），
 *  很容易接成"同名对齐"。把两种组合都测一遍，就能一次分开两种完全不同的病因：
 *    N(正常 11/13) 与 S(交换 13/11) **都是 FF** ⇒ 模块没在 SPI 模式（SEL 档位 / 供电 / MISO 没接）
 *    N=FF 而 **S=01**                          ⇒ **MISO/MOSI 接反了**，对调两根线即可
 *    N=01                                      ⇒ 芯片活着，问题不在接线
 *    N 或 S = 00                               ⇒ MISO 被拉住（CS 与 RSTPDN 并接 / 短路）
 *  注意：库给 bitbang 配的是 **LSB first**（Adafruit_PN532 的约定），
 *  `Adafruit_SPIDevice::transfer()` 真的按它移位，所以这里同样必须 LSB。 */
static uint8_t rfidSpiXferOn(uint8_t mosi, uint8_t sck, uint8_t miso, uint8_t b) {
    uint8_t in = 0;
    for (uint8_t i = 0; i < 8; i++) {
        digitalWrite(mosi, (b >> i) & 1);
        delayMicroseconds(2);
        digitalWrite(sck, HIGH);            // mode 0：上升沿采样
        delayMicroseconds(2);
        if (digitalRead(miso)) {
            in |= (uint8_t)(1u << i);
        }
        digitalWrite(sck, LOW);
        delayMicroseconds(2);
    }
    return in;
}

static uint8_t rfidSpiRawStatusPins(uint8_t sck, uint8_t miso, uint8_t mosi, uint8_t cs) {
    pinMode(sck, OUTPUT);
    pinMode(mosi, OUTPUT);
    pinMode(miso, INPUT);
    pinMode(cs, OUTPUT);
    digitalWrite(sck, LOW);
    digitalWrite(mosi, HIGH);
    digitalWrite(cs, HIGH);
    delayMicroseconds(20);

    digitalWrite(cs, LOW);
    delayMicroseconds(5);
    rfidSpiXferOn(mosi, sck, miso, 0x02);   // StatusRead
    const uint8_t st = rfidSpiXferOn(mosi, sck, miso, 0x00);
    digitalWrite(cs, HIGH);
    delayMicroseconds(10);
    return st;
}
#endif

static void otherRfidPlaceholderAction(int idx) {
    feature_active = true;

    bool     ok      = false;
    uint32_t probeMs = 0;

#if RFID_USE_I2C
    // ══════════ I2C 路径（当前 V2 未启用，保留以便随时切回）══════════
    // 复位策略：**按需**，不再无条件 pulse。PN532 正在工作时被突然复位，
    // 其 I2C 引脚可能进到不确定状态把 SDA 拉住 → 总线锁死，此后连主机复位
    // 都解不开（实测："卡死后重启也没用，必须断电"）。
    bool nfcAck0 = i2cPing(0x24);
    if (!nfcAck0) {
        RfidNfc::hardwareReset();
        i2cBusRecover();
        nfcAck0 = i2cPing(0x24);
    }

    // 0x20 = PCF8574 键盘（常驻）、0x75 = IP5306、0x24 = PN532。
    // 0x20 应答 = 总线本身没问题；0x75 缺失是正常的（冷启动时 IP5306 不 alive）。
    const bool pcfAck0  = i2cPing(0x20);
    const bool pmicAck0 = i2cPing(IP5306_ADDR);

    char ack0[48];
    rfidAckLine(ack0, sizeof(ack0), pcfAck0, pmicAck0, nfcAck0);
    otherRfidProbeBanner("RFID: probing PN532 (I2C)...", "", ack0, UI_TEXT);

    // 纯 ACK 闸门：0x24 不应答就不进库里的慢探测（waitready 按 10ms 步进空转）。
    if (nfcAck0) {
        uint32_t t0 = millis();
        ok = RfidNfc::begin();
        probeMs = millis() - t0;

        // 能 ACK 却拿不到固件版本 = 芯片停在陈旧状态，这时才值得复位重试一次
        if (!ok) {
            RfidNfc::hardwareReset();
            i2cBusRecover();
            t0 = millis();
            ok = RfidNfc::begin();
            probeMs = millis() - t0;
        }
    }

    if (!ok) {
        // 失败后**重新**体检：探测前 OK、探测后变 -- ⇒ 是探测过程本身把总线弄死的
        const bool pcfAck1  = i2cPing(0x20);
        const bool pmicAck1 = i2cPing(IP5306_ADDR);
        const bool nfcAck1  = i2cPing(0x24);

        char ack1[48], verdict[48];
        rfidAckLine(ack1, sizeof(ack1), pcfAck1, pmicAck1, nfcAck1);
        if (!pcfAck1 && !pmicAck1) {
            snprintf(verdict, sizeof(verdict), "I2C bus dead - check PN532 wiring/power");
        } else if (!nfcAck1) {
            // 控制 39 字符内：font1 是 6px/字，240 宽只放得下 40 字
            snprintf(verdict, sizeof(verdict), "no ACK at 0x24 - wiring/SEL/RST");
        } else {
            snprintf(verdict, sizeof(verdict), "chip no reply  probe %lums", (unsigned long)probeMs);
        }
        otherRfidProbeBanner("RFID: PN532 NOT ready", verdict, ack1, TFT_RED);
        delay(900);

        requestStatusBarRedraw();
        showNotification("RFID/NFC", "PN532 not found. Check I2C wiring (SDA 8 / SCL 9) and module SEL switch.");
        otherDismissPlaceholder();
        feature_active = false;
        return;
    }

    char ackOk[48], okMsg[48];
    rfidAckLine(ackOk, sizeof(ackOk), i2cPing(0x20), i2cPing(IP5306_ADDR), i2cPing(0x24));
    snprintf(okMsg, sizeof(okMsg), "ready - present a tag  (probe %lums)", (unsigned long)probeMs);
    otherRfidProbeBanner("RFID: PN532 OK", okMsg, ackOk, UI_OK);
    delay(300);
#else
    // ══════════ SPI 路径（V2 现行）══════════
    // PN532 有自己的 4 根线（SCK/MISO/MOSI/CS），**不在 I2C 上**，所以没有
    // "地址 ACK"可探，直接进库探测即可 —— 库的 begin() 本身是有界的
    // （拉 CS → 读固件版本 → 拿不到就返回 false），不会像 I2C 那样吃满超时。
    // 这也正是换 SPI 的意义：RFID 出问题不再牵连键盘和 PMIC。
    char l2[48];
    snprintf(l2, sizeof(l2), "SCK%d MISO%d MOSI%d CS%d",
             PN532_SCK, PN532_MISO, PN532_MOSI, PN532_SS);
    otherRfidProbeBanner("RFID: probing PN532 (SPI)...", l2, "", UI_TEXT);

    {
        const uint32_t t0 = millis();
        ok = RfidNfc::begin();
        probeMs = millis() - t0;
    }

    if (!ok) {
        // 降级诊断：绕过库直接 bitbang 读 StatusRead，并**同时测两种接法**
        // （正常 11/13 与交换 13/11）—— 一次就能分开"接反"和"没在 SPI 模式"。
        const uint8_t rawN = rfidSpiRawStatusPins(PN532_SCK, PN532_MISO, PN532_MOSI, PN532_SS);
        const uint8_t rawS = rfidSpiRawStatusPins(PN532_SCK, PN532_MOSI, PN532_MISO, PN532_SS);

        char verdict[48], hint[48];
        snprintf(verdict, sizeof(verdict), "no reply %lums  N=%02X S=%02X",
                 (unsigned long)probeMs, (unsigned)rawN, (unsigned)rawS);

        if (rawN == 0x01) {
            snprintf(hint, sizeof(hint), "chip alive - wiring is fine");
        } else if (rawS == 0x01) {
            // 交换组合能通 ⇒ MISO/MOSI 接反了
            snprintf(hint, sizeof(hint), "MISO/MOSI SWAPPED - swap 11<->13");
        } else if (rawN == 0xFF && rawS == 0xFF) {
            // 两种都不通：MISO 没人驱动
            snprintf(hint, sizeof(hint), "MISO idle: SEL!=SPI or no VCC");
        } else if (rawN == 0x00 || rawS == 0x00) {
            snprintf(hint, sizeof(hint), "MISO low: CS/RST tied to GND?");
        } else {
            snprintf(hint, sizeof(hint), "odd N/S - check all 4 lines");
        }

        otherRfidProbeBanner("RFID: PN532 NOT ready", verdict, hint, TFT_RED);
        delay(1800);

        requestStatusBarRedraw();
        showNotification("RFID/NFC",
                         "PN532 not found. SCK12 / MISO11 / MOSI13 / CS1, "
                         "RSTPDN 10k to 3V3, SEL switch to SPI.");
        otherDismissPlaceholder();
        feature_active = false;
        return;
    }

    {
        char okMsg[48], l3[48];
        snprintf(okMsg, sizeof(okMsg), "PN532 OK  probe %lums", (unsigned long)probeMs);
        snprintf(l3, sizeof(l3), "present a tag on the coil");
        otherRfidProbeBanner("RFID: PN532 OK (SPI)", okMsg, l3, UI_OK);
        delay(300);
    }
#endif

    feature_exit_requested = false;
    setTouchButtonInputEnabled(true);
    for (;;) {
        RfidNfc::clearSessionRetry();
        switch (idx) {
            case 0:
                RfidNfc::sessionCardReader();
                break;
            case 1:
                RfidNfc::sessionClone();
                break;
            case 2:
                RfidNfc::sessionErase();
                break;
            case 3:
                RfidNfc::sessionDump();
                break;
            case 4:
                RfidNfc::sessionDecodeAccess();
                break;
            case 5:
                RfidNfc::sessionJamReader();
                break;
            case 6:
                RfidNfc::sessionTagDisrupt();
                break;
            case 7:
                RfidNfc::sessionDisruptEmulate();
                break;
            default:
                feature_active = false;
                restoreSdAfterSharedSpi();
                return;
        }
        if (feature_exit_requested || !RfidNfc::consumeSessionRetry()) {
            break;
        }
        feature_exit_requested = false;
    }
    restoreSdAfterSharedSpi();
    otherRfidReturnGuard();
    submenu_initialized = false;
    displaySubmenu();
    feature_active = false;
}

static void otherGpsPlaceholderAction(int idx) {
    feature_active = true;
    if (idx == 0) {
        feature_exit_requested = false;
        setTouchButtonInputEnabled(true);
        for (;;) {
            GpsWardriver::clearSessionRetry();
            GpsWardriver::session();
            if (feature_exit_requested || !GpsWardriver::consumeSessionRetry()) {
                break;
            }
            feature_exit_requested = false;
        }
        setTouchButtonInputEnabled(false);
    } else {
        switch (idx) {
            case 1:
                GpsSatelliteScanner::session();
                break;
            default:
                feature_active = false;
                return;
        }
    }
    otherRfidReturnGuard();
    submenu_initialized = false;
    displaySubmenu();
    feature_active = false;
}

void handleOtherSubmenuButtons() {
    if (other_layer == OTHER_LAYER_HOME) {
        const int og_rows =
            (other_NUM_SUBMENU_ITEMS + OTHER_GRID_COLS - 1) / OTHER_GRID_COLS;

        if (isButtonPressed(BTN_UP)) {
            int row = current_submenu_index / OTHER_GRID_COLS;
            if (row > 0) {
                current_submenu_index -= OTHER_GRID_COLS;
            } else {
                current_submenu_index += OTHER_GRID_COLS * (og_rows - 1);
            }
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }

        if (isButtonPressed(BTN_DOWN)) {
            int row = current_submenu_index / OTHER_GRID_COLS;
            if (row < og_rows - 1) {
                current_submenu_index += OTHER_GRID_COLS;
            } else {
                current_submenu_index -= OTHER_GRID_COLS * (og_rows - 1);
            }
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }

        if (isButtonPressed(BTN_LEFT)) {
            int col = current_submenu_index % OTHER_GRID_COLS;
            if (col > 0) {
                current_submenu_index--;
            } else {
                current_submenu_index++;
            }
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }

        if (isButtonPressed(BTN_RIGHT)) {
            int col = current_submenu_index % OTHER_GRID_COLS;
            if (col < OTHER_GRID_COLS - 1) {
                current_submenu_index++;
            } else {
                current_submenu_index--;
            }
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }
    } else {
        if (isButtonPressed(BTN_UP)) {
            current_submenu_index =
                (current_submenu_index - 1 + active_submenu_size) % active_submenu_size;
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }

        if (isButtonPressed(BTN_DOWN)) {
            current_submenu_index = (current_submenu_index + 1) % active_submenu_size;
            last_interaction_time = millis();
            displaySubmenu();
            delay(200);
        }
    }

    if (isButtonPressed(BTN_SELECT)) {
        last_interaction_time = millis();
        delay(200);

        if (other_layer == OTHER_LAYER_HOME) {
            if (current_submenu_index == other_NUM_SUBMENU_ITEMS - 1) {
                in_sub_menu = false;
                feature_active = false;
                feature_exit_requested = false;
                displayMenu();
                handleButtons();
                is_main_menu = false;
            } else if (current_submenu_index == 0) {
                other_layer = OTHER_LAYER_IR;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
            } else if (current_submenu_index == 1) {
                other_layer = OTHER_LAYER_RFID;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
            } else if (current_submenu_index == 2) {
                other_layer = OTHER_LAYER_GPS;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
            }
        } else if (other_layer == OTHER_LAYER_IR) {
            if (current_submenu_index == ir_NUM_SUBMENU_ITEMS - 1) {
                other_layer = OTHER_LAYER_HOME;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                feature_active = false;
                feature_exit_requested = false;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
                is_main_menu = false;
            } else if (current_submenu_index == 0) {
                current_submenu_index = 0;
                in_sub_menu = true;
                feature_active = true;
                feature_exit_requested = false;
                IRRemoteFeature::setup();
                while (current_submenu_index == 0 && !feature_exit_requested) {
                    current_submenu_index = 0;
                    in_sub_menu = true;
                    IRRemoteFeature::loop();
                    if (featureExitButtonPressed()) {
                        in_sub_menu = true;
                        is_main_menu = false;
                        submenu_initialized = false;
                        feature_active = false;
                        feature_exit_requested = false;
                        displaySubmenu();
                        delay(200);
                        while (featureExitButtonPressed()) {
                        }
                        break;
                    }
                }
                if (feature_exit_requested) {
                    in_sub_menu = true;
                    is_main_menu = false;
                    submenu_initialized = false;
                    feature_active = false;
                    feature_exit_requested = false;
                    displaySubmenu();
                    delay(200);
                }
            } else if (current_submenu_index == 1) {
                current_submenu_index = 1;
                in_sub_menu = true;
                feature_active = true;
                feature_exit_requested = false;
                IRSavedProfile::setup();
                while (current_submenu_index == 1 && !feature_exit_requested) {
                    current_submenu_index = 1;
                    in_sub_menu = true;
                    IRSavedProfile::loop();
                    if (featureExitButtonPressed()) {
                        in_sub_menu = true;
                        is_main_menu = false;
                        submenu_initialized = false;
                        feature_active = false;
                        feature_exit_requested = false;
                        displaySubmenu();
                        delay(200);
                        while (featureExitButtonPressed()) {
                        }
                        break;
                    }
                }
                if (feature_exit_requested) {
                    in_sub_menu = true;
                    is_main_menu = false;
                    submenu_initialized = false;
                    feature_active = false;
                    feature_exit_requested = false;
                    displaySubmenu();
                    delay(200);
                }
            } else if (current_submenu_index == 2) {
                current_submenu_index = 2;
                in_sub_menu = true;
                feature_active = true;
                feature_exit_requested = false;
                IRUniversalController::setup();
                while (current_submenu_index == 2 && !feature_exit_requested) {
                    current_submenu_index = 2;
                    in_sub_menu = true;
                    IRUniversalController::loop();
                    if (featureExitButtonPressed()) {
                        in_sub_menu = true;
                        is_main_menu = false;
                        submenu_initialized = false;
                        feature_active = false;
                        feature_exit_requested = false;
                        displaySubmenu();
                        delay(200);
                        while (featureExitButtonPressed()) {
                        }
                        break;
                    }
                }
                if (feature_exit_requested) {
                    in_sub_menu = true;
                    is_main_menu = false;
                    submenu_initialized = false;
                    feature_active = false;
                    feature_exit_requested = false;
                    displaySubmenu();
                    delay(200);
                }
            }
        } else if (other_layer == OTHER_LAYER_RFID) {
            if (current_submenu_index == rfid_NUM_SUBMENU_ITEMS - 1) {
                other_layer = OTHER_LAYER_HOME;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
                is_main_menu = false;
            } else {
                otherRfidPlaceholderAction(current_submenu_index);
            }
        } else if (other_layer == OTHER_LAYER_GPS) {
            if (current_submenu_index == gps_NUM_SUBMENU_ITEMS - 1) {
                other_layer = OTHER_LAYER_HOME;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
                is_main_menu = false;
            } else {
                otherGpsPlaceholderAction(current_submenu_index);
            }
        }
    }

    if (!feature_active) {
        int x, y;
        if (!readTouchXY(x, y)) { return; }
        delay(10);

        int touched_slot = -1;
        if (other_layer == OTHER_LAYER_HOME) {
            for (int i = 0; i < other_NUM_SUBMENU_ITEMS; i++) {
                int column = i % OTHER_GRID_COLS;
                int row = i / OTHER_GRID_COLS;
                int x_position = (column == 0) ? X_OFFSET_LEFT : X_OFFSET_RIGHT;
                int y_position = Y_START + row * Y_SPACING;
                int button_x1 = x_position;
                int button_y1 = y_position;
                int button_x2 = x_position + 100;
                int button_y2 = y_position + 60;
                if (x >= button_x1 && x <= button_x2 && y >= button_y1 && y <= button_y2) {
                    touched_slot = i;
                    break;
                }
            }
        } else {
            for (int i = 0; i < active_submenu_size; i++) {
                int yPos = submenuItemY(i);

                int button_x1 = 10;
                int button_y1 = yPos;
                int button_x2 = 220;
                int button_y2 = yPos + 28;

                if (x >= button_x1 && x <= button_x2 && y >= button_y1 && y <= button_y2) {
                    touched_slot = i;
                    break;
                }
            }
        }

        if (touched_slot < 0) {
            return;
        }

        current_submenu_index = touched_slot;
        last_interaction_time = millis();
        displaySubmenu();
        delay(200);

        if (other_layer == OTHER_LAYER_HOME) {
            if (current_submenu_index == other_NUM_SUBMENU_ITEMS - 1) {
                in_sub_menu = false;
                feature_active = false;
                feature_exit_requested = false;
                displayMenu();
                handleButtons();
                is_main_menu = false;
            } else if (current_submenu_index == 0) {
                other_layer = OTHER_LAYER_IR;
                other_menu_grid_initialized = false;
                last_other_menu_index = -1;
                current_submenu_index = 0;
                updateActiveSubmenu();
                submenu_initialized = false;
                displaySubmenu();
            } else if (current_submenu_index == 1) {
                other_layer = OTHER_LAYER_RFID;
                other_menu_grid_initialized = false;
