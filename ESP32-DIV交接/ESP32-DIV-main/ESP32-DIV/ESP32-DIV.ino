                submenu_initialized = false;
                displaySubmenu();
                is_main_menu = false;
            } else {
                otherGpsPlaceholderAction(current_submenu_index);
            }
        }
    }
}

/** 关于页是纯静态绘制，抽出来以便息屏唤醒后重绘。 */
static void drawAboutPage() {
  feature_active = true;
  feature_exit_requested = false;

  tft.fillScreen(UI_BG);
  currentBatteryVoltage = readBatteryVoltage();
  drawStatusBar(currentBatteryVoltage, true);

  uiSetTextDatum(TL_DATUM);
  uiSetTextSize(1);

  uiSetTextFont(2);
  uiSetTextColor(UI_ICON, UI_BG);
  uiSetCursor(16, 40);
  tftPrintObf(OBF_PN, sizeof(OBF_PN));

  uiSetTextFont(1);
  uiSetTextColor(UI_DIM_TEXT, UI_BG);
  uiSetCursor(16, 60);
  uiPrint("by ");
  tftPrintObf(OBF_DN, sizeof(OBF_DN));
  uiPrint(" - ");
  uiPrint(ESP32DIV_VERSION);

  tft.drawFastHLine(12, 78, 216, UI_LINE);

  const int xLabel = 16;
  const int xValue = 80;
  int y = 96;
  const int step = 22;

  uiSetTextColor(UI_DIM_TEXT, UI_BG);
  uiSetCursor(xLabel, y);
  uiPrint("Board");
  uiSetTextColor(UI_TEXT, UI_BG);
  uiSetCursor(xValue, y);
  uiPrint(ESP32DIV_BOARD_NAME);
  y += step;

  // 2026-10-10：邮箱 / GitHub 两行已按需求移除，仅保留 Board + Web。
  uiSetTextColor(UI_DIM_TEXT, UI_BG);
  uiSetCursor(xLabel, y);
  uiPrint("Web");
  uiSetTextColor(UI_TEXT, UI_BG);
  uiSetCursor(xValue, y);
  tftPrintObf(OBF_WB, sizeof(OBF_WB));

  uiSetTextColor(UI_DIM_TEXT, UI_BG);
  uiSetCursor(16, 300);
  uiPrint("SELECT / tap to go back");
}

void handleAboutPage() {
  drawAboutPage();

  while (!feature_exit_requested) {
    // 从息屏电量屏唤醒：整屏被覆盖过，重绘一次
    if (screenConsumeRepaintRequest()) {
      drawAboutPage();
    }

    if (isButtonPressed(BTN_SELECT) || isButtonPressed(BTN_LEFT)) {
      last_interaction_time = millis();
      feature_exit_requested = true;
      delay(200);
      break;
    }

    int x, ty;
    if (readTouchXY(x, ty)) {
      last_interaction_time = millis();
      feature_exit_requested = true;
      delay(200);
      break;
    }

    delay(20);
  }

  feature_active = false;
  feature_exit_requested = false;
  in_sub_menu = false;
  submenu_initialized = false;

  menu_initialized = false;
  last_menu_index = -1;
  is_main_menu = false;
  displayMenu();
}

void handleSettingsSubmenuButtons() {

  feature_active = true;
  feature_exit_requested = false;

  AppSettingsUI::setup();
  while (!feature_exit_requested) {
    AppSettingsUI::loop();
  }

  feature_active = false;
  feature_exit_requested = false;

  in_sub_menu = false;
  submenu_initialized = false;

  menu_initialized = false;
  last_menu_index = -1;
  is_main_menu = false;
  displayMenu();
}

/* ==================== 息屏保护：动态画面功能排除名单 ====================
 * 这些功能跑起来时屏幕一直在动（实时列表 / 波形 / 计数 / 扫描），
 * 超时息屏会把活画面打断成低亮度电量屏 —— 所以运行期间**不自动息屏**。
 *
 * 名字直接取自本文件顶部的各 *_submenu_items[] 数组。
 * ⚠ 改菜单文字时这里要同步，否则该功能会漏保护。
 * 没列进来的（Saved Profile / SD File Manager / Update Firmware /
 * Card Clone / Erase / Dump / Universal Controller 等）都是静态界面，
 * 照常按 Settings 里的超时息屏。 */
static const char* const kDynamicScreenFeatures[] = {
    // ── WiFi ──
    "Packet Monitor", "Beacon Spammer", "WiFi Deauther", "Probe Request Flood",
    "Deauth Detector", "WiFi Scanner", "Captive Portal", "Hidden SSID Revealer",
    "WPS Scanner", "ARP Scanner", "Karma Attack",
    // ── Bluetooth ──
    "BLE Jammer", "BLE Spoofer", "Sour Apple", "AirTag Spoofer", "AirTag Sniffer",
    "Sniffer", "BLE Scanner", "BLE Rubber Ducky", "Skimmer Detect",
    // ── nRF24 ──
    "Scanner", "Proto Kill", "ESB Sniffer", "ESB Replay", "MouseJack Scan",
    // ── Sub-GHz ──
    "Replay Attack", "SubGHz Jammer", "De Bruijn / Brute", "Jamming Detector",
    // ── Tools ──
    "Serial Monitor", "Touch Calibrate",
    // ── 其它 ──
    "Record",                       // IR：录音倒计时
    // RFID：这几个都要"等标签贴上"（listen 20s / Clone 每阶段 45s）并有实时状态，
    // 息屏会把等待界面糊掉，让用户没法判断标签有没有被识别到。
    "Card Reader", "Card Clone", "Erase", "Dump", "Decode Access",
    "Jam Reader", "Tag Disrupt", "Disrupt Emulate",
    "Wardriver", "Satellite Scanner",
};

/** 当前子菜单项是否属于"动态画面功能"。 */
static bool screenFeatureIsDynamic() {
    if (!active_submenu_items) return false;
    if (current_submenu_index < 0 || current_submenu_index >= active_submenu_size) return false;
    const char* nm = active_submenu_items[current_submenu_index];
    if (!nm) return false;
    for (size_t i = 0; i < sizeof(kDynamicScreenFeatures) / sizeof(kDynamicScreenFeatures[0]); i++) {
        if (strcmp(nm, kDynamicScreenFeatures[i]) == 0) return true;
    }
    return false;
}

/**
 * 自动息屏闸门（注册给 utils 的 screenIdleTick）。
 *   feature_active == false → 主菜单 / 子菜单列表：允许息屏
 *   feature_active && !in_sub_menu → Settings / 关于页：静态且自带唤醒重绘钩子，允许息屏
 *   feature_active && in_sub_menu  → 真功能屏：只有动态画面的那些禁掉
 */
static bool autoOffAllowed() {
    if (!feature_active) return true;
    if (!in_sub_menu)    return true;
    return !screenFeatureIsDynamic();
}

/**
 * 息屏唤醒后把界面整体重建一遍。
 * 息屏时会整屏清掉画电量屏，所以唤醒必须重绘，否则屏上会残留电池图。
 * 主菜单/子菜单/关于页这类"静态绘制"的界面在这里直接重建；
 * 功能屏（feature_active）自己有重绘节拍，留给它通过
 * screenConsumeRepaintRequest() 自查，这里不插手。
 */
static void onScreenWakeRepaint() {
    if (feature_active) {
        return;                       // 标志保留，交给功能屏自己的循环消费
    }
    screenConsumeRepaintRequest();    // 本次已由本函数处理，清掉标志

    drawStatusBar(currentBatteryVoltage, true);
    menu_initialized = false;
    last_menu_index  = -1;
    if (in_sub_menu) {
        submenu_initialized = false;
        displaySubmenu();
    } else {
        displayMenu();
    }
}

void handleButtons() {
    if (in_sub_menu) {
        switch (current_menu_index) {

            case 0: handleWiFiSubmenuButtons(); break;
            case 1: handleNRFSubmenuButtons(); break;
            case 2: handleOtherSubmenuButtons(); break;
            case 3: /* Settings: full-screen AppSettings, not list submenu */ break;
            case 4: handleBluetoothSubmenuButtons(); break;
            case 5: handleSubGHzSubmenuButtons(); break;
            case 6: handleToolsSubmenuButtons(); break;
            default: break;
        }
    } else {

        if (isButtonPressed(BTN_UP) && !is_main_menu) {
            current_menu_index--;
            if (current_menu_index < 0) {
                current_menu_index = NUM_MENU_ITEMS - 1;
            }
            last_interaction_time = millis();
            displayMenu();
            delay(200);
        }

        if (isButtonPressed(BTN_DOWN) && !is_main_menu) {
            current_menu_index++;
            if (current_menu_index >= NUM_MENU_ITEMS) {
                current_menu_index = 0;
            }
            last_interaction_time = millis();
            displayMenu();
            delay(200);
        }

        if (isButtonPressed(BTN_LEFT) && !is_main_menu) {
            int row = current_menu_index % 4;
            if (current_menu_index >= 4) {
                current_menu_index = row;
            } else if (current_menu_index == 0) {
                current_menu_index = 3;
            } else {
                current_menu_index = row - 1;
            }
            last_interaction_time = millis();
            displayMenu();
            delay(200);
        }

        if (isButtonPressed(BTN_RIGHT) && !is_main_menu) {
            int row = current_menu_index % 4;
            if (current_menu_index < 4) {
                current_menu_index = row + 4;
            } else if (current_menu_index == 7) {
                current_menu_index = 0;
            } else {
                current_menu_index = row + 5;
            }
            last_interaction_time = millis();
            displayMenu();
            delay(200);
        }

        if (isButtonPressed(BTN_SELECT)) {
            last_interaction_time = millis();
            delay(200);

            if (current_menu_index == 3) {
                handleSettingsSubmenuButtons();
            } else if (current_menu_index == 7) {
                handleAboutPage();
            } else {
                updateActiveSubmenu();

                if (active_submenu_items && active_submenu_size > 0) {
                    current_submenu_index = 0;
                    if (current_menu_index == 2) {
                        other_layer = OTHER_LAYER_HOME;
                        other_menu_grid_initialized = false;
                        last_other_menu_index = -1;
                    }
                    in_sub_menu = true;
                    submenu_initialized = false;
                    displaySubmenu();
                }

                if (is_main_menu) {
                    is_main_menu = false;
                    displayMenu();
                } else {
                    is_main_menu = true;
                }
            }
        }

        static unsigned long lastTouchTime = 0;
        const unsigned long touchFeedbackDelay = 100;

        if (!feature_active && (millis() - lastTouchTime >= touchFeedbackDelay)) {
            int x, y;
            if (!readTouchXY(x, y)) { return; }
            delay(10);
        for (int i = 0; i < NUM_MENU_ITEMS; i++) {
                int column = i / 4;
                int row = i % 4;
                int x_position = (column == 0) ? X_OFFSET_LEFT : X_OFFSET_RIGHT;
                int y_position = Y_START + row * Y_SPACING;

                int button_x1 = x_position;
                int button_y1 = y_position;
                int button_x2 = x_position + 100;
                int button_y2 = y_position + 60;

                if (x >= button_x1 && x <= button_x2 && y >= button_y1 && y <= button_y2) {
                    current_menu_index = i;
                    last_interaction_time = millis();
                    displayMenu();

                    unsigned long startTime = millis();
                    while (isTouchDownDismiss() && (millis() - startTime < touchFeedbackDelay)) {
                        delay(10);
                    }

                    if (isTouchDownDismiss()) {

                        if (current_menu_index == 3) {
                            handleSettingsSubmenuButtons();
                        } else if (current_menu_index == 7) {
                            handleAboutPage();
                        } else {
                            updateActiveSubmenu();

                            if (active_submenu_items && active_submenu_size > 0) {
                                current_submenu_index = 0;
                                if (current_menu_index == 2) {
                                    other_layer = OTHER_LAYER_HOME;
                                    other_menu_grid_initialized = false;
                                    last_other_menu_index = -1;
                                }
                                in_sub_menu = true;
                                submenu_initialized = false;
                                displaySubmenu();
                            } else {
                                if (is_main_menu) {
                                    is_main_menu = false;
                                    displayMenu();
                                } else {
                                    is_main_menu = true;
                                }
                            }
                        }
                    }
                    delay(200);
                    break;
                }
            }
        }
    }
}

void setup() {
  Serial.begin(115200);
  delay(50);
  Serial.println("[boot] start");

  // ── 第一件事：把 PN532 从复位态放出来 ──
  // 必须早于任何 I2C 访问（尤其 initPcf8574Buttons 的键盘探测）：
  // 芯片吊在复位态会扰动 I2C，导致键盘探测失败 ⇒ 五个按键全部按不动。
  // 详见 utils.cpp 的 bootReleasePn532Reset()。
  bootReleasePn532Reset();

  // 紧跟一次总线恢复：如果上次运行把 I2C 锁死了（从机还拉着 SDA），
  // 这一步能在**不断电**的情况下解开 —— 否则按复位键重启也没用。
  // 必须在 Wire.begin() 之前（i2cBusRecover 用 GPIO 手动打时钟）。
  if (i2cBusRecover()) {
    Serial.println("[boot] I2C bus was stuck -> recovered");
  }

  // ---- 复位原因诊断：插拔 USB 后看本行，确认是 BROWNOUT(欠压) 还是 POWERON(EN被拉低) ----
  {
    esp_reset_reason_t r = esp_reset_reason();
    const char* rs = "OTHER";
    if (r == ESP_RST_POWERON)       rs = "POWERON(断电/EN拉低再上电)";
    else if (r == ESP_RST_BROWNOUT) rs = "BROWNOUT(3.3V欠压跌落)";
    else if (r == ESP_RST_SW)       rs = "SW(软件ESP.restart)";
    else if (r == ESP_RST_EXT)      rs = "EXT(外部引脚)";
    else if (r == ESP_RST_WDT)      rs = "WDT(看门狗)";
    else if (r == ESP_RST_DEEPSLEEP) rs = "DEEPSLEEP";
    Serial.printf("[RESET] reason=%d (%s)\n", (int)r, rs);
  }

  // 插拔 USB 时 IP5306 在 电池BOOST<->VIN直供 间切换，3.3V 会出现瞬态跌落，
  // 触发 brownout 复位（V1 经典ESP32 原已禁用，V2/S3 漏了，这里补齐）。
  // 根治是在 IP5306 SYS 输出端加大 bulk 电容吸收瞬态；此处为软件规避。
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

  tft.init();
  tft.setRotation(TFT_ROTATION);

  ledcSetup(PWM_CHANNEL, PWM_FREQ, PWM_RESOLUTION);
  ledcAttachPin(BACKLIGHT_PIN, PWM_CHANNEL);
  setBrightness(80);

  applyThemeToPalette(settings().theme);

  tft.fillScreen(TFT_BLACK);

  // ── 开机动画已移除（省 Flash + 启动更快）───────────────────────────
  // 原来这里有两段：
  //   loading(100, UI_ICON, 0, 0, 2, true);   // 骷髅头 10 帧动画，2 轮 ≈ 2 s
  //   displayLogo(TFT_WHITE, 500);            // CiferTech logo + 版本号
  // 去掉 displayLogo() 的**调用**后，链接器的 --gc-sections 会顺带裁掉
  // displayLogo() 本体和它专用的 bitmap_icon_cifer（150×150，2850 B）。
  // ⚠ 不要删 loading() 与那 10 帧 bitmap_icon_skull_loading_*（共 15600 B）：
  //   wifi.cpp 有 8 处、bluetooth.cpp 有 1 处仍用它做扫描等待动画，
  //   删掉会连带破坏那些功能页。想省这块只能连那些调用一起改。

  initSDCard();

#if BOARD_HAS_ESP32S3
  settingsLoad();
#else
  // Avoid SD mount via settingsLoad on v1 (same crash as step 3).
  settingsApplyBoardTouchDefaults();
  Serial.println("[boot] settings defaults (v1, SD deferred)");
#endif
  applyThemeToPalette(settings().theme);
  setBrightness(settings().brightness);

  // 界面语言（上次在 Settings 里存下的；无 SD 卡时回落到英文）
  g_lang = settings().lang;

#if HAS_PCF8574_BUTTONS
  if (!initPcf8574Buttons()) {
    Serial.println("PCF8574 buttons unavailable");
  }
#else
  Serial.println("PCF8574 buttons disabled for this board");
#endif

  // 启动 I2C 体检条：总线上到底有什么、键盘芯片能不能真读出数据，直接打屏。
  // 必须放在 startStatusBarTask() **之前** —— 那个任务每 400ms 重画顶部状态栏，
  // 放在它后面会让这 2.5s 的停留期间体检条被覆盖掉。
  bootI2cSelftest();

#if BOARD_HAS_ESP32S3
  ensureBleStackReady();
#else
  // Classic ESP32: defer NimBLE; also skip boot-time WiFi scan task (heap/WDT).
  Serial.println("[boot] BLE/WiFi-bg deferred (v1)");
#endif

#if FEATURE_BLE_DUCKY
  Ducky::setup();
#endif

#if BOARD_HAS_ESP32S3
  WifiScan::startBackgroundScanner();
  BleScan::startBackgroundScanner();
  startStatusBarTask();
#else
  // Keep boot lightweight on ESP32 — status bar updates from loop() instead.
#endif

  menu_initialized = false;
  currentBatteryVoltage = readBatteryVoltage();
  displayMenu();
  drawStatusBar(currentBatteryVoltage, false);

  setupTouchscreen();

  last_interaction_time = millis();
  screenNoteActivity();          // 息屏计时从"启动完成"这一刻起算
  screenSetWakeHook(onScreenWakeRepaint);   // 息屏唤醒后整体重绘当前界面
  screenSetAutoOffGate(autoOffAllowed);     // 动态画面功能运行期间不自动息屏

  // 2026-10-09 开机自检音（诊断 IO45）：上电流程走完后无条件响 300ms。
  // 2026-10-20 诊断完成——自检音能响 = IO45 飞线/引脚/供电全通，开机调用移除。
  // 它故意无视 Settings→Key Beep 开关，常开会被当成"按键音没存住"。
  // 函数本体保留（utils.cpp uiBeepSelfTest），以后排蜂鸣器硬件时临时挂回。
  Serial.println("[boot] ready");
}

void loop() {
  applyThemeToPalette(settings().theme);
  handleButtons();
  updateStatusBar();
  notificationTick();   // 提示类弹窗（无 Save 按钮）到点自动消失
  uiBeepPoll();         // 按键音到点关闭（非阻塞）
  // 按键音计时说明：功能运行时主 loop 会被功能自己的 while 卡住，但按键音
  // 只有 45~60ms，短鸣在功能循环内由下一拍 isButtonPressed 之外的自然节拍
  // 收尾即可；此处覆盖"没有功能在跑"的空档。
  screenIdleTick();
  screenDbgRedraw();    // 临时：屏幕调试日志层（串口损坏替代，SCREEN_DEBUG 关 0 撤除）
}
